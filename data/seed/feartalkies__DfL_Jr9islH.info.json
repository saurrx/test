nt": 0}, {"author": "sreethan_rao", "author_id": "3954380376", "id": "18340412551278643", "text": "The thief is the father. He married the lady, his gold is what bought the scholar, his gold is what was left with the baby near the king which helped him grow....so basically he was the reason for his birth and growth", "timestamp": 1793677344, "like_count": 3}, {"author": "noralperson", "author_id": "55701116225", "id": "18147486724585861", "text": "Whoever raised you is probably the true father but then you consider that the theif played the biggest role since he was the one who gave the 1000 gold coins", "timestamp": 1793651397, "like_count": 3}, {"author": "funnyowl.exe", "author_id": "76738180557", "id": "18030831890868270", "text": "The King, the Thief bought a woumb, the scolar sold his seeds, but the King who nurtured the child and brought him up is the real father", "timestamp": 1793597375, "like_count": 52}, {"author": "khadija._.k0321", "author_id": "23892427670", "id": "18209614993323252", "text": "A real father is the one that provides for you, takes care of you, and is there for you. Seems like the king fits the standard.", "timestamp": 1793564745, "like_count": 3}, {"author": "_._soniasharma_._", "author_id": "10820409541", "id": "18118891069791046", "text": "Ritual wise it should be the thief.", "timestamp": 1793556928, "like_count": 0}, {"author": "eva.pooja", "author_id": "20333242253", "id": "17937491907404952", "text": "Use his full name pls, it's Vikramaditya, one word..", "timestamp": 1793556255, "like_count": 8}, {"author": "mahartarun366", "author_id": "54023212682", "id": "18506720497097759", "text": "All 3 😁 because if thief didn't ask the women than there will be no cycle of karma that lead to his birth, due to which scholar meet the women and give child a fresh and blood has per 🤔 child birth destiny and in end the faith lead him to the king who become the foster father who raise him", "timestamp": 1793545061, "like_count": 2}, {"author": "sawal_shrad", "author_id": "7828577156", "id": "18069551843782082", "text": "Waiting", "timestamp": 1793539548, "like_count": 1}, {"author": "itz_me_nvtj", "author_id": "63981385168", "id": "18134461537826669", "text": "The king a blood with a name is nothing if it doesn't gets a good life", "timestamp": 1793529757, "like_count": 6}, {"author": "priyanka_rk369", "author_id": "48677948576", "id": "18342542203272340", "text": "First hand - thief", "timestamp": 1793528748, "like_count": 1}], "webpage_url": "https://www.instagram.com/p/DfL_Jr9islH/", "webpage_url_basename": "DfL_Jr9islH", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "thumbnail": "https://scontent-ord5-2.cdninstagram.com/v/t51.82787-15/883452997_17971863209965523_1802436562357190128_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=NDAyMDU4NDgzNDk2NzE5MzkyNzE3OTcxODYzMjA2OTY1NTIz.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fdXNlcl91cGxvYWRlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=1EQ-F2BrksgQ7kNvwGrhHUA&_nc_oc=Adq3pj4ilzaXf6pLIBQxz0cgborr973bIZQyDI6dCJO94adOwOsSkma-f6s7uV2YVFA&_nc_zt=23&_nc_ht=scontent-ord5-2.cdninstagram.com&_nc_gid=rwmkggCQOx0O_rOuYALgAg&_nc_ss=70689&oh=00_AQSnzPrCGf-J7vVk6LmMFYCUnal9dy6DkRycmS9ec7JAZA&oe=6AF7E57B", "display_id": "DfL_Jr9islH", "fulltitle": "Video by feartalkies", "upload_date": "20261101", "epoch": 1794249299, "format": "dash-1431781142268141v - 1080x1920 (DASH video)+dash-1431780648934857a - audio only (DASH audio)", "format_id": "dash-1431781142268141v+dash-1431780648934857a", "ext": "mp4", "protocol": "https+https", "format_note": "DASH video+DASH audio", "tbr": 1519.006, "width": 1080, "height": 1920, "resolution": "1080x1920", "dynamic_range": "SDR", "vcodec": "vp09.00.40.08.00.01.01.01.00", "vbr": 1451.433, "aspect_ratio": 0.56, "acodec": "mp4a.40.5", "abr": 67.573, "asr": 44100, "_type": "video", "_version": {"version": "2026.10.26", "release_git_head": "c91f8de0bfb3577