MDE4MTQzNzE0OTc3NTcwOTg0.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX3VzZXJfdXBsb2FkZWRfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=NkyFwFd38-oQ7kNvwECCrFO&_nc_oc=AdoeI_8Kepl_dSVTNz_HLt2fSRCbs4rKFg8dg4JKf4cWs16C8M7Gidwn1XmCyW_4czcOUfhY2C-j-8FdxgATGoYU&_nc_zt=23&_nc_ht=instagram.fblr2-3.fna&_nc_gid=P3wu_t_hAptQFCJ2vrYuGQ&_nc_ss=70689&oh=00_AQRQiUsYWtprWpV4RVUxjQGq3QYihrp7AOOsuYGhfS_x_g&oe=6AF7FDCE", "width": 1080, "height": 1080, "id": "11", "resolution": "1080x1080"}, {"url": "https://instagram.fblr2-3.fna.fbcdn.net/v/t51.82787-15/863101055_18143714983570984_3899789902780217637_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=108&_nc_map=urlgen_bucketless&ig_cache_key=NDAxMjQ5NDA2MTQwMDc3MzAyMDE4MTQzNzE0OTc3NTcwOTg0.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX3VzZXJfdXBsb2FkZWRfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=NkyFwFd38-oQ7kNvwECCrFO&_nc_oc=AdoeI_8Kepl_dSVTNz_HLt2fSRCbs4rKFg8dg4JKf4cWs16C8M7Gidwn1XmCyW_4czcOUfhY2C-j-8FdxgATGoYU&_nc_zt=23&_nc_ht=instagram.fblr2-3.fna&_nc_gid=P3wu_t_hAptQFCJ2vrYuGQ&_nc_ss=70689&oh=00_AQTwqKxc-cXBUfBpMgd3mKq3KAiyEEF1rvDmP3i_kNHQyA&oe=6AF7FDCE", "width": 1080, "height": 1920, "id": "12", "resolution": "1080x1920"}], "comments": [{"author": "_l4ughinfoxx", "author_id": "52161758058", "id": "18054023324812491", "text": "His friend Patroclus ok 😂😂", "timestamp": 1794150907, "like_count": 0}, {"author": "chaotic_.darl", "author_id": "64603837198", "id": "17937787914401314", "text": "PATROCLUS WAS NOT ACHILLES'S FRIEND. MERE LABELS ARENT ENOUGH TO DESCRIBE WHAT THEY WERE.", "timestamp": 1793859508, "like_count": 0}, {"author": "__cvntyy_", "author_id": "72445395749", "id": "17894165253683873", "text": "PARTROCLUS AND FRIENDD?!!", "timestamp": 1793791990, "like_count": 0}, {"author": "a_vinylrecord_a_day", "author_id": "12329488634", "id": "18131066542837514", "text": "Achilles was honorable. \nDefining people into Heroes and Villains is inaccurate. They’re two side of the same coin. One can be a hero to many and at the same time a villain to just as many. Honor is what matters", "timestamp": 1793292659, "like_count": 3}, {"author": "mel_ina_pant", "author_id": "68924153356", "id": "18111046900924430", "text": "Well i mean everyone is a villain in someone's else story for priam as he saw from Achilles he may be a villain to troy but not a monster", "timestamp": 1793127086, "like_count": 1}, {"author": "aileen_autumn", "author_id": "1460758450", "id": "18104855867299329", "text": "After killing Hector, Achilles stripped him of his armour, tied him by the heels to the back of his chariot, and dragged his body through the dirt around the walls of Troy. Only after this brutal humiliation did Achilles return Hector’s body to King Priam.", "timestamp": 1793099376, "like_count": 1}, {"author": "professionallyquiet_", "author_id": "27166190698", "id": "18415417417084617", "text": "Patroculus was anything but friend 🙂", "timestamp": 1792697130, "like_count": 21}, {"author": "lets.go.to.the.mall_today", "author_id": "7903231596", "id": "18100013639419535", "text": "Stop calling Patroclus his \"friend\" 😭", "timestamp": 1792619206, "like_count": 140}, {"author": "bhavishyakhanwani", "author_id": "64781870747", "id": "18130587322695969", "text": "Hero for his comarads and vilan for his opponents, at lest he is just a soldier", "timestamp": 1792604124, "like_count": 5}, {"author": "myrazz_175", "author_id": "79710284501", "id": "18627990226060480", "text": "At this point, I feel like those gods just have nothing interesting to do and are toying with those people", "timestamp": 1792602492, "like_count": 7}, {"author": "missruu18", "author_id": "76587519199", "id": "18037604420851283", "text": "All this is because my guy Apollo was like \"hmmm..she rejected me...nobody ever rejects me so let me just curse her thats sounds fair\"", "timestamp": 1792598496, "like_count": 431}], "webpage_url": "https://www.instagram.com/p/DevPhb5KFGc/", "webpage_url_base