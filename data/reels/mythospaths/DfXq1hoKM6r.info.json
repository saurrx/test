TRL8qOZrHpuzLcOGaQlNMKC5u6gF2rt8YmVvPNVyQemyH65&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=hfmkiCYg2X845rjV-WfWZw&_nc_ss=70689&oh=00_AQSNTwVB42GsZwszqHjFiudLU_NRlEKtgGJQ8pi0Bcdu6g&oe=6AF83363", "width": 1080, "height": 1080, "id": "11", "resolution": "1080x1080"}, {"url": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/890716535_18147896071570984_3820578671128903899_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=103&_nc_map=urlgen_bucketless&ig_cache_key=NDAyMzg3MzE4ODI3MTgwNDA3NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=L_Hg9497OoUQ7kNvwFglpc9&_nc_oc=AdqQ2gmdx7gZcBUppS2ibQ0YtkiMMLQX4j85TSWH3TRL8qOZrHpuzLcOGaQlNMKC5u6gF2rt8YmVvPNVyQemyH65&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=hfmkiCYg2X845rjV-WfWZw&_nc_ss=70689&oh=00_AQTw_FB8Uny60yyotVspPE1hqcLLnymuQ_fDC6l_NhywDw&oe=6AF83363", "width": 1080, "height": 1920, "id": "12", "resolution": "1080x1920"}], "comments": [{"author": "williamsjoni", "author_id": "1234925543", "id": "18038378021846131", "text": "Athena is your usual right wing, trad wife focused, internalized misogyny prop that the patriarchy likes to idolize and center but never likes or respects.", "timestamp": 1794169097, "like_count": 0}, {"author": "jaynecanwrite", "author_id": "44022198982", "id": "18075861842765925", "text": "By the way, this would have been a good opportunity for Athena to redeem herself, and show other worshippers that not all gods or goddesses are bad. But of course, pride wouldn’t let her. \n\nAs someone who used to adore Athena, I am beyond disappointed. There’s a huge difference in how she treated the male Greek heroes and the women who crossed paths with her", "timestamp": 1794042633, "like_count": 8}, {"author": "giog_io31", "author_id": "77839671554", "id": "18071075288782788", "text": "Athena never cursed the Gorgon Medusa BTW. You're confusing Greek and Roman myths. What kind of Mediterranean salad is this?", "timestamp": 1794039938, "like_count": 0}, {"author": "sera_hateslosers", "author_id": "78150565183", "id": "18027295007875692", "text": "I don't understand why accounts like these always try to defame the gods and shift the shape of the story completely.  First off, these myths and stories about the Greek gods are all Roman tales, not something that really happened and if you know the history between the Romans and the Greeks you'd understand why such an obnoxious story is formulated. THE GODS ARE NOT THEIR MYTHS.  The end of the story is that of course Athena was mad, NOT BECAUSE ARACHNAE WOVE WITHOUT A MISTAKE but because she tried to defame the gods to the people. HUBRIS IS ALSO A SIN, and i think people forget this part. Then when Athena struck her with the loom and destroyed it, Arachnae tried to hang herself but Athena walked in and feeling pity for the girl she turned her into a spider so she could enjoy weaving and be famously known for it.  STOP POTRAYING THE GODS AS SO.", "timestamp": 1794025178, "like_count": 0}, {"author": "agabai_jaibai", "author_id": "48362783869", "id": "18122305444993213", "text": "Day by day I’m starting to hate Athena", "timestamp": 1793986173, "like_count": 9}, {"author": "kimbosiwang", "author_id": "5352734", "id": "17991231387082660", "text": "Isn't it similar to how forces nature is like? Unpredictable, dangerous and often unfair.", "timestamp": 1793986127, "like_count": 2}, {"author": "stranger_things.fan4life", "author_id": "78223806668", "id": "18608856913064913", "text": "I feel ashamed being named after 'Athena'", "timestamp": 1793968923, "like_count": 2}, {"author": "https.sshree", "author_id": "71469759723", "id": "17874302451640864", "text": "The Goddess of wisdom wasn't so wise afterall..", "timestamp": 1793965452, "like_count": 4}, {"author": "galileothephilisopher", "author_id": "77812629838", "id": "18102922223564036", "text": "Athena screams Donald Trump", "timestamp": 1793958944, "like_count": 107}, {"author": "bornfromfire_", "author_id": "15441209874", "id": "18132994192771780", "text": "Greek and Roman gods aint god's they r demons with no morality just like hiranyakashyapu", "timestamp": 1793958348, "like_count": 0}, {"author": "lvcrexya", "author_id": "55626850894", "id": "18135046915805466", "text": "Athena is insecure btch", "timestamp": 1793957215, "like_count": 0}, {"author": "rozeii.y", "author_id": "73921601581", "id": "18348272659252393", "text": "Ofc it's athena", "timestamp": 1793956420, "like_count": 3}], "webpage_url": "https://www.instagram.com/p/DfXq1hoKM6r/", "webpage_url_basename": "DfXq1hoKM6r", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "thumbnail": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/890716535_18147896071570984_3820578671128903899_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=103&_nc_map=urlgen_bucketless&ig_cache_key=NDAyMzg3MzE4ODI3MTgwNDA3NQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=L_Hg9497OoUQ7kNvwFglpc9&_nc_oc=AdqQ2gmdx7gZcBUppS2ibQ0YtkiMMLQX4j85TSWH3TRL8qOZrHpuzLcOGaQlNMKC5u6gF2rt8YmVvPNVyQemyH65&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=hfmkiCYg2X845rjV-WfWZw&_nc_ss=70689&oh=00_AQTw_FB8Uny60yyotVspPE1hqcLLnymuQ_fDC6l_NhywDw&oe=6AF83363", "display_id": "DfXq1hoKM6r", "fulltitle": "Video by mythospaths", "upload_date": "20261105", "epoch": 1794271944, "url": "https://instagram.fblr22-2.fna.fbcdn.net/o1/v/t2/f2/m86/AQMXcp1poZ1E3xQ1KYdX9sKjJkzYb7CeKTW1z1rs8sOJ0yLkDLpcW8WJU_qU8b-IhN6KHyTmDW67P8wQBfDcxk4LCvfGQ61zqjnHhjk.mp4?_nc_cat=106&_nc_oc=AdrbZecaH-YQmR1u5VlCqr_XCMnrBLDMt33F4ifvS80s1V4jgGjoHnWiJP1ss5C5rwW3kuj8WbEN5pbYO5WjB8GY&_nc_sid=5e9851&_nc_ht=instagram.fblr22-2.fna.fbcdn.net&_nc_ohc=URWbEyoSrv4Q7kNvwFcy0Ku&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTEyMDA1MzQyNzUzMzUzMCwiYXNzZXRfYWdlX2RheXMiOjQs