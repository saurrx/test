093924092250669", "text": "Part 3 found me right after I followed from part 2 🙌", "timestamp": 1792244186, "like_count": 0}, {"author": "_lord.goldfyre_", "author_id": "48962078429", "id": "18012526769768902", "text": "Who still blames Helen at this day nd age??", "timestamp": 1792216542, "like_count": 1}], "webpage_url": "https://www.instagram.com/p/Dehbktqq994/", "webpage_url_basename": "Dehbktqq994", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "thumbnail": "https://instagram.fblr22-2.fna.fbcdn.net/v/t51.82787-15/859669636_18143714497570984_4830209359669420146_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=110&_nc_map=urlgen_bucketless&ig_cache_key=NDAwODYwNjQxMzUyNzcwMzQxNjE4MTQzNzE0NDk0NTcwOTg0.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX3VzZXJfdXBsb2FkZWRfdGh1bWJuYWlsLkMzIn0%3D&_nc_ohc=WdF7KHJX79oQ7kNvwHG8rCx&_nc_oc=Adp6NaDW545y8oIcrCw9xuHybWeKMrpztGQWh2M9EHsighnMMmii_SjemHhlmCO8axxg9242Oc-n2aRtlW70TzHB&_nc_zt=23&_nc_ht=instagram.fblr22-2.fna&_nc_gid=YqPi1-GedFKwyFjOUvqNyA&_nc_ss=70689&oh=00_AQQAuMQ5u3RxZju2u8CBh3jf7ozBe6LyZaroEM10dguuyA&oe=6AF81AFB", "display_id": "Dehbktqq994", "fulltitle": "Video by mythospaths", "upload_date": "20261015", "epoch": 1794268460, "format": "dash-1941061773994249v - 1080x1920 (DASH video)+dash-1941032820663811a - audio only (DASH audio)", "format_id": "dash-1941061773994249v+dash-1941032820663811a", "ext": "mp4", "protocol": "https+https", "format_note": "DASH video+DASH audio", "tbr": 2324.002, "width": 1080, "height": 1920, "resolution": "1080x1920", "dynamic_range": "SDR", "vcodec": "vp09.00.40.08.00.02.02.02.00", "vbr": 2273.395, "aspect_ratio": 0.56, "acodec": "mp4a.40.5", "abr": 50.607, "asr": 48000, "_type": "video", "_version": {"version": "2026.10.26", "release_git_head": "c91f8de0bfb3577894abad716eaaa01659e6bd14", "repository": "yt-dlp/yt-dlp"}}