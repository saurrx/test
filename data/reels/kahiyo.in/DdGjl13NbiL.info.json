{"id": "DdGjl13NbiL", "title": "Video by kahiyo.in", "description": "जिस बेटे को पिता ने सीईओ बनाया, उसी के सामने पिता पर चोरी का आरोप लगा।\n\nबाप का कद | एपिसोड 1 — बैग की तलाशी\n\nहरिराम के बैग से कंपनी का स्कैनर मिला। सबूत सामने था, लेकिन सच अभी बाकी था। आप निखिल की जगह होते तो पहले पिता पर भरोसा करते या जाँच पर?\n\nआगे की कहानी जानने के लिए Kahiyo प्रोफ़ाइल देखें।\nकभी सुनो, कभी कहियो। 🎧\n\n#BaapKaKad #HindiKahani #HindiDrama #EmotionalStory #ShortDrama #ReelsIndia #Kahiyo", "channel": "kahiyo.in", "uploader_id": "32047977584", "uploader": "Kahiyo", "timestamp": 1789034068, "like_count": 210, "comment_count": 5, "http_headers": {"Referer": "https://www.instagram.com/"}, "formats": [{"format_id": "dash-29063534623248570a", "ext": "m4a", "tbr": 77.613, "asr": 48000, "format_note": "DASH audio", "container": "m4a_dash", "vcodec": "none", "acodec": "mp4a.40.5", "url": "https://instagram.fblr2-2.fna.fbcdn.net/o1/v/t2/f2/m78/AQMA1i9pc3GiZN-09_snO7QC4Znqf3TQ4JuF5SgtMXSCApgK9yok0wJbihjxLUIaDueKt4elbZYcWXVJjXl_jmyid7dT-LXv4fiewPY.mp4?_nc_cat=101&_nc_oc=Adrq5Da-ZLUDgTCSBxuTVw2JkaUJGmV_0MFKWx0q_3ZMzUIEEmOScOfRfr6Zev9C7hh7fMNR5cMlyC6kfrfDlu7_&_nc_sid=9ca052&_nc_ht=instagram.fblr2-2.fna.fbcdn.net&_nc_ohc=rCrID4UntHAQ7kNvwFTgqEC&&ccb=17-1&_nc_gid=TtM33qCDWAXLQx4WD5t_0Q&_nc_ss=70689&_nc_map=urlgen_bucketless&_nc_zt=28&oh=00_AQRlv1vc2LRkqArmCtw0SIQG0gxHTM4Il7UGh17XQkwzig&oe=6AF41F76", "manifest_stream_number": 0, "is_dash_periods": true, "protocol": "https", "audio_ext": "m4a", "video_ext": "none", "vbr": 0, "abr": 77.613, "resolution": "audio only", "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.instagram.com/"}, "format": "dash-29063534623248570a - audio only (DASH audio)"}, {"url": "https://instagram.fblr2-2.fna.