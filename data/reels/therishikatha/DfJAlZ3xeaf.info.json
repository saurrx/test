ZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=qcCMdZB8aYYQ7kNvwH9rjz4&_nc_oc=AdrsI-uSa4FMp27aDkVkmMK_gsaVYfqaj1yjpcR1jDCUF3IY6q1DJ3w6-dWcmBb2ZC9X8Y00r9c-o9JOahTQgAX7&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=07ouM0InKfb__emuk3SXLg&_nc_ss=70689&oh=00_AQQHCCiHmBDNDxZaJnbi6S4HSEiBbp1QIuihUrLT7-GBNQ&oe=6AF820D7", "width": 750, "height": 750, "id": "10", "resolution": "750x750"}, {"url": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/874204766_18130755223755882_5781049831796044601_n.jpg?stp=c0.420.1080.1080a_dst-jpg_e15_s1080x1080_tt6&_nc_cat=107&_nc_map=urlgen_bucketless&ig_cache_key=NDAxOTc0NjcxMjgwNDc3OTY3OQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=qcCMdZB8aYYQ7kNvwH9rjz4&_nc_oc=AdrsI-uSa4FMp27aDkVkmMK_gsaVYfqaj1yjpcR1jDCUF3IY6q1DJ3w6-dWcmBb2ZC9X8Y00r9c-o9JOahTQgAX7&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=07ouM0InKfb__emuk3SXLg&_nc_ss=70689&oh=00_AQTHhxRVtDmKG-MSCBHhsI_Q33djO7mGFSmpiTmq8BwM6A&oe=6AF820D7", "width": 1080, "height": 1080, "id": "11", "resolution": "1080x1080"}, {"url": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/874204766_18130755223755882_5781049831796044601_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=107&_nc_map=urlgen_bucketless&ig_cache_key=NDAxOTc0NjcxMjgwNDc3OTY3OQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=qcCMdZB8aYYQ7kNvwH9rjz4&_nc_oc=AdrsI-uSa4FMp27aDkVkmMK_gsaVYfqaj1yjpcR1jDCUF3IY6q1DJ3w6-dWcmBb2ZC9X8Y00r9c-o9JOahTQgAX7&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=07ouM0InKfb__emuk3SXLg&_nc_ss=70689&oh=00_AQTmyVx3jtIwNWbEu68mxKhmqo3Mz1ISZZFpiX83ZhzX2w&oe=6AF820D7", "width": 1080, "height": 1920, "id": "12", "resolution": "1080x1920"}], "comments": [{"author": "_imgkr", "author_id": "64080369682", "id": "18132924100700338", "text": "Uttarakanda is a clear interpolation , not even according to Hindu scholars but also according to Western academia . The writing style is the classical Panini Sanskrit in Uttarakanda meanwhile the whole first 6 Kandas are in archaic Sanskrit without the Panini grammar . The Yuddha Kanda ends with Phalshruti , which marks the end of Hindu literature everywhere by telling what one gains from reading this text . Lets not even go to the millions of contradictions in the Uttarakanda", "timestamp": 1794240554, "like_count": 0}, {"author": "dhananjaysejwal", "author_id": "2083300777", "id": "18148874851568161", "text": "Is this nonsense in valmiki ramayana?", "timestamp": 1794222355, "like_count": 0}, {"author": "rghvs_", "author_id": "52832642322", "id": "17907542472605420", "text": "Fake story. Ramyana ended with Rama's glorious and righteous reign of Ayodhya. Other stories are just forced add-ons to stretch the legacy.", "timestamp": 1793813022, "like_count": 0}, {"author": "manan_vish_1011", "author_id": "63530963004", "id": "17910182352326163", "text": "These all are kalpbheda of shri ram's leela 🙌\"हरि अनन्त हरिकथा अनन्ता\"", "timestamp": 1793803023, "like_count": 1}, {"author": "kalkivatar", "author_id": "9152107005", "id": "17915786025545694", "text": "Then society blamed Sita and pressured Ram, today the same society blames Ram. Nothing have changed, the people will blame all except themselves. Btw monarchy portrayed in Ramayan is not same as European monarchy, here the king simply can not rule over the public's demand, he is bound to fulfill it.", "timestamp": 1793684304, "like_count": 0}, {"author": "kunal.code1011", "author_id": "53390507934", "id": "18634980472041851", "text": "One curse .... endless suffering for Ram.", "timestamp": 1793618729, "like_count": 0}, {"author": "tanay.305", "author_id": "4282284170", "id": "18116239418111716", "text": "Please stop using this later added uttar kand. This was never in the original ramayana by valmiki", "timestamp": 1793602883, "like_count": 0}, {"author": "huma.nomics", "author_id": "31740472709", "id": "18105487952019798", "text": "A king always comes above his personal wishes, and desires. He did right, he had to live by values of conventional morality. No king , however great has the power to upend social morality of his time, he is a guardian, not its dictator", "timestamp": 1793571397, "like_count": 0}, {"author": "_sw_aryan", "author_id": "3189668303", "id": "17870866956660675", "text": "Made up hai seriously mt lo ramayan ends simply with ravan defeated and happy ever after", "timestamp": 1793555192, "like_count": 0}, {"author": "skrrttc0bain", "author_id": "68038862906", "id": "18132890981307206", "text": "i thought that part was filler", "timestamp": 1793515673, "like_count": 0}, {"author": "mythology_love09", "author_id": "65828934725", "id": "17878055985576687", "text": "You see this is the beauty of Valmiki Ramayan. Ram was never treated as an all powerful god but he was very human. He made mistakes and learned from them so he can become an example which was the OG goal of this avatar.  When Sita's character is questioned again, Ram is stuck between his duty as a king and his duty as a husband which is a dilemma that lots of monarch face. He constantly grills himself over this and ultimately chooses his duty as a king but regrets it forever which again is a very human reaction. Now, I do think he could have corrected his subjects over such gossip instead of leaving her and I don't like that he lacked that spine. The thing is, any other characters or Valmiki himself never justifies this action of his and he is criticised for it which is why even Sita leaves him at the end. That was the consequences of his actions.", "timestamp": 1793508750, "like_count": 29}], "webpage_url": "https://www.instagram.com/p/DfJAlZ3xeaf/", "webpage_url_basename": "DfJAlZ3xeaf", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "thumbnail": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/874204766_18130755223755882_5781049831796044601_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=107&_nc_map=urlgen_bucketless&ig_cache_key=NDAxOTc0NjcxMjgwNDc3OTY3OQ%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=qcCMdZB8aYYQ7kNvwH9rjz4&_nc_oc=AdrsI-uSa4FMp27aDkVkmMK_gsaVYfqaj1yjpcR1jDCUF3IY6q1DJ3w6-dWcmBb2ZC9X8Y00r9c-o9JOahTQgAX7&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=07ouM0InKfb__emuk3SXLg&_nc_ss=70689&oh=00_AQTmyVx3jtIwNWbEu68mxKhmqo3Mz1ISZZFpiX83ZhzX2w&oe=6AF820D7", "display_id": "DfJAlZ3xeaf", "fulltitle": "Video by therishikatha", "upload_date": "20261031", "epoch": 1794257794, "format": "dash-1151424201167915v - 1080x1920 (DASH video)+dash-1151423861167949a - audio only (DASH audio)", "format_id": "dash-1151424201167915v+dash-1151423861167949a", "ext": "mp4", "protocol": "https+https", "format_note": "DASH video+DASH audio", "tbr": 2966.025, "width": 1080, "height": 1920, "resolution": "1080x1920", "dynamic_range": "SDR", "vcodec": "vp09.00.40.08.00.02.02.05.00", "vbr": 2905.643, "aspect_ratio": 0.56, "acodec": "mp4a.40.5", "abr": 60.382, "asr": 48000, "_type": "video", "_version": {"version": "2026.10.26", "release_git_head": "c91f8de0bfb3577894abad716eaaa01659e6bd14", "repository": "yt-dlp/yt-dlp"}}