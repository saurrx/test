mestamp": 1794201366, "like_count": 0}, {"author": "niveditasinha862", "author_id": "14722881889", "id": "18059845874799176", "text": "😍👏", "timestamp": 1793000865, "like_count": 0}, {"author": "ur_bidesi_deb", "author_id": "37829112517", "id": "18071128583502496", "text": "My surname is Modak", "timestamp": 1792864273, "like_count": 1}, {"author": "parledu_le", "author_id": "58905312387", "id": "18247946233312216", "text": "Thats why no one compares newly wed couples or \"about to marry\" couples to shiv-parvati eventhough their love is amazing and eternal. the comparision is always done with lakshmi-narayan, because, whynot? narayan is the ruler of the whole existence, and lakshmi is the goddess of prosperity.", "timestamp": 1792849230, "like_count": 3}, {"author": "vidhi.i_", "author_id": "12152606389", "id": "17987829092882220", "text": "Vijay got inspired from here", "timestamp": 1792740753, "like_count": 2}, {"author": "chaudharyharendragawar", "author_id": "63579520921", "id": "17866477794679727", "text": "“I will bring pain to this world for my mom” hehe❤️❤️❤️🔥🔥🔥", "timestamp": 1792514723, "like_count": 0}, {"author": "popsiclecandance", "author_id": "72055834540", "id": "18058929674800795", "text": "I’m a Muslim but honestly these videos are so fun to watch and I learn so much about Hindu mythology and culture every time I get a reel from your account. I really love your work and I think I’ve grown to love your religion even more now, pure love from the Muslim community for my beloved Hindus🫶🏼✨", "timestamp": 1792477859, "like_count": 63}, {"author": "kabirbhatt2111", "author_id": "70813324674", "id": "18434119174196831", "text": "Aparna is the name of my mom🫠", "timestamp": 1792386840, "like_count": 24}, {"author": "raghavkr_1002", "author_id": "9612710707", "id": "18078384446406330", "text": "Don’t get me wrong but the text was so fast I have to pause and read it.", "timestamp": 1792329990, "like_count": 51}, {"author": "yours.plabon06", "author_id": "48090756131", "id": "18146974681603613", "text": "Har har mahadev🙌", "timestamp": 1792318699, "like_count": 0}], "webpage_url": "https://www.instagram.com/p/DeBKeb8TLIA/", "webpage_url_basename": "DeBKeb8TLIA", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "thumbnail": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/830540254_18121564741755882_7721332385941530925_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=105&_nc_map=urlgen_bucketless&ig_cache_key=Mzk5OTUyNDAxNjEzMzgxMjczNjE4MTIxNTY0NzM1NzU1ODgy.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fdXNlcl9zZWxlY3RlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=xJh6sy0qN18Q7kNvwGvMXX7&_nc_oc=AdrRxNuNZ937jOculZHZ8NmZRpTzfCts2oEIP8aqm5lIavD3BMQquivJE9npDQ2xGKnIeJSWX0trXVy9-bpMXbbh&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=nSj1pnMLMaDWYUakjyCAbQ&_nc_ss=70689&oh=00_AQSi4cWVDVC7a6UJkwnRo_d2d6qN1L3hPpmmzFa9xoQ5tg&oe=6AF805A1", "display_id": "DeBKeb8TLIA", "fulltitle": "Video by therishikatha", "upload_date": "20261003", "epoch": 1794259241, "format": "dash-1500683671865908v - 720x1280 (DASH video)+dash-1500668345200774a - audio only (DASH audio)", "format_id": "dash-1500683671865908v+dash-1500668345200774a", "ext": "mp4", "protocol": "https+https", "format_note": "DASH video+DASH audio", "tbr": 1448.243, "width": 720, "height": 1280, "resolution": "720x1280", "dynamic_range": "SDR", "vcodec": "vp09.00.31.08.00.01.01.01.00", "vbr": 1401.687, "aspect_ratio": 0.56, "acodec": "mp4a.40.5", "abr": 46.556, "asr": 44100, "_type": "video", "_version": {"version": "2026.10.26", "release_git_head": "c91f8de0bfb3577894abad716eaaa01659e6bd14", "repository": "yt-dlp/yt-dlp"}}