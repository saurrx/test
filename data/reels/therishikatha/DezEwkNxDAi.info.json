, "like_count": 0}, {"author": "manishadsharma18", "author_id": "23686910863", "id": "18649488829045782", "text": "Nope", "timestamp": 1793864948, "like_count": 0}, {"author": "chetanaborkar2", "author_id": "5943685965", "id": "18134513677823963", "text": "Knew it", "timestamp": 1793765766, "like_count": 1}, {"author": "fra.nau24", "author_id": "25361424797", "id": "18192838066405495", "text": "No", "timestamp": 1793689472, "like_count": 0}, {"author": "instafreak_r_a", "author_id": "54961907671", "id": "17977419981070720", "text": "Lord Shiva turned as Sundareshwar (White but not blue ) while getting married to devi Parvathi ! 🙌", "timestamp": 1793680978, "like_count": 1}, {"author": "sairuthikplayz", "author_id": "22150228158", "id": "18451250524134940", "text": "All frames and pictures of Lord Shiva are Blue not white so I never knew that ❤️", "timestamp": 1793664020, "like_count": 0}, {"author": "luh.ariiyu", "author_id": "51679118714", "id": "18146883055574016", "text": "Yes", "timestamp": 1793656091, "like_count": 0}, {"author": "__s_aravind_s__", "author_id": "2959107395", "id": "17895109704439923", "text": "Yes i exactly know as hes in mountain", "timestamp": 1793614372, "like_count": 0}, {"author": "chinmayee.likessleeping", "author_id": "79642695742", "id": "18000882276013670", "text": "Yes. Also krishna in sanskrit means the colour black", "timestamp": 1793568662, "like_count": 0}], "webpage_url": "https://www.instagram.com/p/DezEwkNxDAi/", "webpage_url_basename": "DezEwkNxDAi", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "thumbnail": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/863019874_18128250994755882_8934548095982503507_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=105&_nc_map=urlgen_bucketless&ig_cache_key=NDAxMzU3MjYyMjUyMzgzODQ5OA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=giQ2UGhWT80Q7kNvwHie1