less&ig_cache_key=NDAyNDQwODIxMDY4ODkxNzkzMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=tUaFoGhnt6QQ7kNvwH_p_P3&_nc_oc=AdpVMRwuCSKdRYX_6yUjqP4rWfyrF2LEXkspVsA_l-NmWl-QKmzKO0pcFIgE8XRtK5jElY7GCNRDHfepP0em6DZN&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=B2ce39zVTr5IdXpK07gRug&_nc_ss=70689&oh=00_AQQX99qpxz0MOkamjz6gxeiYprdRiIy3hp1e4c9CY7indg&oe=6AF80299", "width": 720, "height": 1280, "id": "9", "resolution": "720x1280"}, {"url": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/883244232_18132471121755882_4868812907698524457_n.jpg?stp=c0.420.1080.1080a_dst-jpg_e35_s750x750_sh2.08_tt6&_nc_cat=109&_nc_map=urlgen_bucketless&ig_cache_key=NDAyNDQwODIxMDY4ODkxNzkzMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=tUaFoGhnt6QQ7kNvwH_p_P3&_nc_oc=AdpVMRwuCSKdRYX_6yUjqP4rWfyrF2LEXkspVsA_l-NmWl-QKmzKO0pcFIgE8XRtK5jElY7GCNRDHfepP0em6DZN&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=B2ce39zVTr5IdXpK07gRug&_nc_ss=70689&oh=00_AQSEd9PthLXfumIblc-AVu11HNt3rVrg1oPrCDQUZaCF_Q&oe=6AF80299", "width": 750, "height": 750, "id": "10", "resolution": "750x750"}, {"url": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/883244232_18132471121755882_4868812907698524457_n.jpg?stp=c0.420.1080.1080a_dst-jpg_e15_s1080x1080_tt6&_nc_cat=109&_nc_map=urlgen_bucketless&ig_cache_key=NDAyNDQwODIxMDY4ODkxNzkzMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=tUaFoGhnt6QQ7kNvwH_p_P3&_nc_oc=AdpVMRwuCSKdRYX_6yUjqP4rWfyrF2LEXkspVsA_l-NmWl-QKmzKO0pcFIgE8XRtK5jElY7GCNRDHfepP0em6DZN&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=B2ce39zVTr5IdXpK07gRug&_nc_ss=70689&oh=00_AQTQxq3E4O_pjwfHQ8GqMOGrxT0dsE-2AcalCfab_3RfkQ&oe=6AF80299", "width": 1080, "height": 1080, "id": "11", "resolution": "1080x1080"}, {"url": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/883244232_18132471121755882_4868812907698524457_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=109&_nc_map=urlgen_bucketless&ig_cache_key=NDAyNDQwODIxMDY4ODkxNzkzMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=tUaFoGhnt6QQ7kNvwH_p_P3&_nc_oc=AdpVMRwuCSKdRYX_6yUjqP4rWfyrF2LEXkspVsA_l-NmWl-QKmzKO0pcFIgE8XRtK5jElY7GCNRDHfepP0em6DZN&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=B2ce39zVTr5IdXpK07gRug&_nc_ss=70689&oh=00_AQQcPyVLrvmKUy1Ul7QzQJylP7JawOJ9KzbWfe5HsAbqsA&oe=6AF80299", "width": 1080, "height": 1920, "id": "12", "resolution": "1080x1920"}], "comments": [{"author": "debasmitasrkr", "author_id": "70179637908", "id": "18114830774167175", "text": "Thousands of brahma is acceptable but not vishnu. Vishnu never d**s. He is immortal just like Shiva.", "timestamp": 1794131616, "like_count": 0}, {"author": "shrutisharmaindia", "author_id": "8939413518", "id": "18054779105811028", "text": "The skulls belong to Parvati, from different lifetimes.", "timestamp": 1794107828, "like_count": 0}, {"author": "itzz_vihaan2013", "author_id": "75278439392", "id": "18076009652742194", "text": "The king of serpents was also known as phanindra", "timestamp": 1794075471, "like_count": 0}, {"author": "_d3m6n", "author_id": "21864460768", "id": "18136701580659188", "text": "Lord Shiva does not carry the heads of both Brahma and Vishnu.\nAccording to Hindu mythology, Shiva (or his fierce form, Bhikshatana / Kalabhairava) severed only one head—the fifth head of Brahma—and is often depicted carrying or wearing that single skull (known as Brahma-kapala). He never severed or carried a head of Vishnu. \nThe Decapitation: Lord Brahma originally had five heads. Because of Brahma's growing ego, a dispute over supremacy, or disrespect shown toward Shiva, Shiva (or his emanation, Kalabhairava) severed Brahma’s fifth head.\nThe Skull and Penance: The severed head of Brahma became stuck to Shiva's palm as a skull (kapala). Shiva had to wander the worlds as a mendicant (Bhikshatana) carrying the skull and atoning for the symbolic sin of Brahmahatya (slaying a Brahmana) until he reached Varanasi, where the skull finally fell from his hand. \nVishnu's Role: Vishnu was never decapitated; in the traditional accounts of the Lingodbhava or supremacy debates, Vishnu either recognized Shiva's infinite nature and surrendered with humility or acted as a witness/mediator.", "timestamp": 1794040935, "like_count": 0}, {"author": "not_ss_vini", "author_id": "45136802331", "id": "18118752359328627", "text": "He adorned the moon to remove the curse of Prajapati Daksh on Moon", "timestamp": 1794017169, "like_count": 10}, {"author": "eshwariphad", "author_id": "49480370299", "id": "17959707921257554", "text": "The moon is not held on his head due to that, it was because king daksh (sati’s father) had all his other daughters married to MOON (all the 27 nakshatras are king daksh daughter) but moon used to only favor one wife rohini. All the other wives complained and daksh cursed moon to fade away forever but he got saved by shiva’s boon where moon would fade, but he would slowly come back too. (Waning moon and waxing moon)", "timestamp": 1793981457, "like_count": 4}, {"author": "jaiminvarsani", "author_id": "56615619223", "id": "18602499805066159", "text": "There are so many variations with this story. This is the third one I heard. The most widely accepted version is: Parvati held it in the throat.", "timestamp": 1793971832, "like_count": 13}, {"author": "oyeeeanmmol", "author_id": "2257577560", "id": "17890421568478866", "text": "Skulls and Boar Tusk. How does Shiva wear the Boar Tusk, like a pendant sort of?", "timestamp": 1793971665, "like_count": 46}, {"author": "vivek.shetty.9", "author_id": "5950211668", "id": "18136935286580564", "text": "If shiva cannot take poison and needs chandra above his head , then how can he be wearing the garland of heads belonging to Vishnu and Brahma.\n\nOne who cannot control the poison without external aid , how can he wear them as garland of skills", "timestamp": 1793968604, "like_count": 5}, {"author": "therishikatha", "author_id": "22569163881", "id": "17996223291047282", "text": "Which one do you wear? 😬", "timestamp": 1793967005, "like_count": 6}], "webpage_url": "https://www.instagram.com/p/DfZkfIFR0Gt/", "webpage_url_basename": "DfZkfIFR0Gt", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "thumbnail": "https://instagram.fblr22-1.fna.fbcdn.net/v/t51.82787-15/883244232_18132471121755882_4868812907698524457_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=109&_nc_map=urlgen_bucketless&ig_cache_key=NDAyNDQwODIxMDY4ODkxNzkzMw%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEwODAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ%3D%3D&_nc_ohc=tUaFoGhnt6QQ7kNvwH_p_P3&_nc_oc=AdpVMRwuCSKdRYX_6yUjqP4rWfyrF2LEXkspVsA_l-NmWl-QKmzKO0pcFIgE8XRtK5jElY7GCNRDHfepP0em6DZN&_nc_zt=23&_nc_ht=instagram.fblr22-1.fna&_nc_gid=B2ce39zVTr5IdXpK07gRug&_nc_ss=70689&oh=00_AQQcPyVLrvmKUy1Ul7QzQJylP7JawOJ9KzbWfe5HsAbqsA&oe=6AF80299", "display_id": "DfZkfIFR0Gt", "fulltitle": "Video by therishikatha", "upload_date": "20261106", "epoch": 1794258532, "format": "dash-2307787426816341v - 1080x1920 (DASH video)+dash-2307523360176081a - audio only (DASH audio)", "format_id": "dash-2307787426816341v+dash-2307523360176081a", "ext": "mp4", "protocol": "https+https", "format_note": "DASH video+DASH audio", "tbr": 1043.1509999999998, "width": 1080, "height": 1920, "resolution": "1080x1920", "dynamic_range": "SDR", "vcodec": "vp09.00.40.08.00.02.02.05.00", "vbr": 989.848, "aspect_ratio": 0.56, "acodec": "mp4a.40.5", "abr": 53.303, "asr": 48000, "_type": "video", "_version": {"version": "2026.10.26", "release_git_head": "c91f8de0bfb3577894abad716eaaa01659e6bd14", "repository": "yt-dlp/yt-dlp"}}