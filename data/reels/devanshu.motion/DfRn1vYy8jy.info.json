5haWwuQzMifQ%3D%3D&_nc_ohc=guwP5Z_-NGoQ7kNvwHU2JIg&_nc_oc=AdoSQM_tip37_V0r5jQnPdEQLP7-9_7bBsZIEuZjBwRSBtgnN6YQkRr0_qvQkdhLaPPmMjsVYyKvI0Ppo58bhEI7&_nc_zt=23&_nc_ht=instagram.fblr2-3.fna&_nc_gid=Erd9xWx1tsJf8ZKPlosByw&_nc_ss=70689&oh=00_AQSr8y9Ji2ucLo6q-hhY4_ZJaoXpSUESp_9f8q5pywxxfA&oe=6AF82642", "width": 540, "height": 540, "id": "9", "resolution": "540x540"}, {"url": "https://instagram.fblr2-3.fna.fbcdn.net/v/t51.82787-15/892331450_18130811602832902_885170743878980841_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=103&_nc_map=urlgen_bucketless&ig_cache_key=NDAyMjE3MTE1OTA0NjYzNzgxMDE4MTMwODExNTkwODMyOTAy.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU0MC5zZHIudmlkZW9fdXNlcl91cGxvYWRlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=guwP5Z_-NGoQ7kNvwHU2JIg&_nc_oc=AdoSQM_tip37_V0r5jQnPdEQLP7-9_7bBsZIEuZjBwRSBtgnN6YQkRr0_qvQkdhLaPPmMjsVYyKvI0Ppo58bhEI7&_nc_zt=23&_nc_ht=instagram.fblr2-3.fna&_nc_gid=Erd9xWx1tsJf8ZKPlosByw&_nc_ss=70689&oh=00_AQSMCQGeBZ1yyeAggelZ9OQ7McrTLk9Sr6AvIIi1HxKz7Q&oe=6AF82642", "width": 540, "height": 960, "id": "10", "resolution": "540x960"}], "comments": [{"author": "rohit_the_incorrigible_mess", "author_id": "4243164137", "id": "18134443774704310", "text": "Interestingly even this has back story, during the Satya Yuga Lord Ganesha tripped after having a lot of sweet Modaks. The Moon God Chandra witnessed this and started laughing, post this Lord Ganesha cursed him that anyone who looks at the moon during Ganesh Chaturthi would face Mithya Dosha - false accusations. This played out 2 Yugas later when Lord Krishna accidentally saw the reflection of the moon on a bowl of milk and the entire set of incidents mentioned in the reel happened. It's mind-boggling how these subplots intermingle into a major plot. Simple brilliance - no wonder Mahabharata is the greatest epic ever written!", "timestamp": 1794261830, "like_count": 0}, {"author": "no_hype_raj", "author_id": "72903757591", "id": "17912781441561742", "text": "Bete ko nahi ,beti ko", "timestamp": 1794259084, "like_count": 0}, {"author": "prassanttam", "author_id": "3177598965", "id": "17953046034300931", "text": "Waiting for next part", "timestamp": 1794235447, "like_count": 0}, {"author": "ll_sonu_5555", "author_id": "64585299259", "id": "18118998635002294", "text": "V", "timestamp": 1794226222, "like_count": 0}, {"author": "__teddy__12_", "author_id": "58351319968", "id": "18134682439771694", "text": "🫱❌🖕✅", "timestamp": 1794222562, "like_count": 0}, {"author": "kanish.joshi.7", "author_id": "68905172915", "id": "18186943612420264", "text": "Jai shree sita ram", "timestamp": 1794218470, "like_count": 0}, {"author": "kanish.joshi.7", "author_id": "68905172915", "id": "17899302696412370", "text": "Jai shree ram", "timestamp": 1794218464, "like_count": 0}, {"author": "gaurav_more_sanatani", "author_id": "13772866492", "id": "17933274624162697", "text": "Story begins with , Ganesh Ji was riding mushakh to go to attend meeting of devtas . Chandradev laughed looking how a fat child fat elephant is riding a little timid mouse. Mushakh feels embarrassed and shamefully hi imbalances and Ganesh Ji falls down. Watching this Chandradev laughs very hard . Ganesh ji gets angry and curses Chandra that you are proud of your looks but your face will become pitch black, no one will look at you , chandradev returns home his wife advices himto apologise to ganpati , he will surely forgive your karm. Chandradev takes some 2-3 devtas on his side to request forgiveness to Ganpati , Mushakh reverses curse saying \"one who will watch moon everyday will be blessed with good looks but one who watches moon on Ganesh Chaturthi will be falsely accused for theft\" . Bhagwan Shri Krushna watched moon on Ganesh Chaturthi and was blessed with that curse . So he was accused of killing Prasen . And rest is the video", "timestamp": 1794217249, "like_count": 0}, {"author": "sparabofficial", "author_id": "1562683169", "id": "17875000566640352", "text": "That was शमंतक मणी", "timestamp": 