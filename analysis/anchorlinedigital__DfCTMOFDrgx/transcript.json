{
 "language": "hi",
 "language_prob": 0.997,
 "segments": [
  {
   "start": 0.0,
   "end": 3.56,
   "text": "अगर आपकी त्रेन राद दोबगजे जंगल के भीच रूचा है"
  },
  {
   "start": 3.56,
   "end": 5.12,
   "text": "तो नीचे माद उतरना"
  },
  {
   "start": 5.12,
   "end": 6.72,
   "text": "पूरा को देरा"
  },
  {
   "start": 6.72,
   "end": 7.84,
   "text": "आसी बन्द"
  },
  {
   "start": 7.84,
   "end": 9.2,
   "text": "सिकनल जीरो"
  },
  {
   "start": 9.2,
   "end": 11.52,
   "text": "लोग तोर्च लेकी नीचे उतरते हैं"
  },
  {
   "start": 11.52,
   "end": 13.04,
   "text": "रोहन नहीं उतरता"
  },
  {
   "start": 13.04,
   "end": 14.72,
   "text": "बगल वाले अंकल कहते हैं"
  },
  {
   "start": 14.72,
   "end": 16.84,
   "text": "तर्वाजा अंदर से बन कर दो"
  },
  {
   "start": 16.84,
   "end": 20.08,
   "text": "तस मिनेड बाद बाहर तुर्च बुचने लबते हैं"
  },
  {
   "start": 20.08,
   "end": 23.78,
   "text": "एक एक करके नीटी"
  },
  {
   "start": 25.34,
   "end": 27.58,
   "text": "फिर दर्वाजे पूर सोर सोर से थबगी"
  },
  {
   "start": 27.58,
   "end": 29.78,
   "text": "फोलो! हम इसी कोचके है"
  },
  {
   "start": 29.78,
   "end": 31.58,
   "text": "अंकल दीरे से कहते हैं"
  },
  {
   "start": 31.58,
   "end": 32.7,
   "text": "मत कोलना"
  },
  {
   "start": 32.7,
   "end": 35.18,
   "text": "बाहर वाला खेरकी पे चाथ चबका देता है"
  },
  {
   "start": 35.18,
   "end": 36.82,
   "text": "रोहन लाइट डालता है"
  },
  {
   "start": 37.14,
   "end": 39.14,
   "text": "बाथ बतीस खाली"
  },
  {
   "start": 39.14,
   "end": 40.54,
   "text": "कोई पैसंजर नहीं"
  },
  {
   "start": 40.54,
   "end": 46.13,
   "text": "और बाथ पार्ट दो के लिए फोलो करो"
  },
  {
   "start": 46.13,
   "end": 48.13,
   "text": "आप दर्वाजा खोलते"
  }
 ]
}