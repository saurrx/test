# media is re-downloadable via scripts; keep repo light
*.mp4
*.webm
*.m4a
*.wav
*.part
*.ytdl
analysis/*/frames/
analysis/*/frames_2s/
__pycache__/
.claude/settings.local.json

# background logs churn constantly; keep them local
data/reels/_download.log
data/seed/_download.log
analysis/_seed_run.log

# per-creator download folders: metadata is force-added by scripts/autocommit.sh every 10 min
data/reels/*/

# keep finished reels and paid audio (a container reclaim must not lose them)
!renders/best/*.mp4
!makes/**/audio/*
!bench/**/*.mp4
